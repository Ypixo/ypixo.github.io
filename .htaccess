# Настройки для хостинга на Apache (reg.ru, Timeweb, Beget и т. п.) — то же, что _headers делает на Netlify.
# Netlify этот файл игнорирует. Копируется в корень dist/ скриптом tools/build-dist.py.

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# Своя страница «не найдено»
ErrorDocument 404 /404.html

# http → https, www → без www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://lugovayadarya.ru%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lugovayadarya.ru%{REQUEST_URI} [L,R=301]
</IfModule>

# Типы файлов, которых может не быть в настройках сервера
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType audio/mpeg .mp3
AddType application/json .json
AddType application/manifest+json .webmanifest

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Кэш: HTML — всегда свежий; CSS/JS (в ссылках ?v=…) — день; медиа — неделя; шрифты — год
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/json "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType audio/mpeg "access plus 7 days"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
